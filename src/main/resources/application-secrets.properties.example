# Secrets Configuration Template
# Copy this file to application-secrets.properties and fill in your actual values
# The application-secrets.properties file is gitignored and should NEVER be committed

# ---------------------------------
# Google OAuth2 Configuration
# ---------------------------------
# To obtain these credentials:
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create OAuth 2.0 Client ID (Web application)
# 3. Add authorized redirect URI: http://localhost:8081/login/oauth2/code/google
google.client-id=your_google_client_id_here
google.client-secret=your_google_client_secret_here

# ---------------------------------
# JWT Secret Key
# ---------------------------------
# Should be a long random string (at least 256 bits / 32 bytes)
# Generate with: openssl rand -base64 64
jwt.secret=your_jwt_secret_key_here_at_least_256_bits

# ---------------------------------
# Database Password
# ---------------------------------
db.password=your_mysql_password

# ---------------------------------
# AWS Credentials
# ---------------------------------
# To obtain these credentials:
# 1. Go to AWS Console -> IAM -> Users -> Your User -> Security Credentials
# 2. Create Access Key -> Application running outside AWS
# 3. Copy the Access Key ID and Secret Access Key
# For local development with AWS CLI configured, you can use:
#   aws.access-key-id=your_aws_access_key_id_here
#   aws.secret-access-key=your_aws_secret_access_key_here
# Or leave these commented out to use AWS CLI default credentials
aws.access-key-id=your_aws_access_key_id_here
aws.secret-access-key=your_aws_secret_access_key_here

# ---------------------------------
# OpenAI API Key
# ---------------------------------
# To obtain API key:
# 1. Go to https://platform.openai.com/api-keys
# 2. Create new secret key
# 3. Copy the key (it will only be shown once)
openai.api.key=your_openai_api_key_here

